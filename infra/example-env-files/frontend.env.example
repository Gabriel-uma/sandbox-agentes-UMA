# Variables de entorno para el Frontend React
# Copia este archivo como .env.local en el directorio raíz de tu aplicación React

# URLs de los servicios Cloud Run desplegados
# Obtener estos valores ejecutando: terraform output frontend_env_config
REACT_APP_DOCUMENT_PROCESSOR_URL=https://rag-document-processor-xxx-uc.a.run.app
REACT_APP_RAG_BACKEND_URL=https://rag-agent-backend-xxx-uc.a.run.app

# Configuración del proyecto GCP
REACT_APP_PROJECT_ID=tu-project-id
REACT_APP_BUCKET_NAME=tu-project-id-rag-documents

# Configuración opcional para desarrollo
REACT_APP_MAX_FILE_SIZE=10485760  # 10MB en bytes
REACT_APP_ALLOWED_FILE_TYPES=.pdf,.txt,.docx,.md
REACT_APP_API_TIMEOUT=30000       # 30 segundos

# Para habilitar logs de desarrollo
REACT_APP_DEBUG=true

# Configuración de autenticación (si implementas auth)
# REACT_APP_AUTH_DOMAIN=tu-dominio.firebaseapp.com
# REACT_APP_AUTH_CLIENT_ID=tu-client-id