# Variables de entorno para los servicios Backend
# Estas variables deben configurarse en las imágenes Docker de Cloud Run

# Configuración del proyecto GCP
PROJECT_ID=tu-project-id
REGION=us-central1

# Cloud Storage
BUCKET_NAME=tu-project-id-rag-documents

# BigQuery
DATASET_ID=rag_chat_history
TABLE_ID=conversations

# Vertex AI Matching Engine
# Obtener estos valores ejecutando: terraform output backend_env_config
INDEX_ENDPOINT=projects/PROJECT_NUMBER/locations/REGION/indexEndpoints/INDEX_ENDPOINT_ID
DEPLOYED_INDEX_ID=rag-deployed-index
VECTOR_INDEX_NAME=projects/PROJECT_NUMBER/locations/REGION/indexes/INDEX_ID

# Service Account
SERVICE_ACCOUNT_EMAIL=rag-agent-service@tu-project-id.iam.gserviceaccount.com

# Configuración de la aplicación
PORT=8080
LOG_LEVEL=info

# Configuración del modelo de embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=768

# Configuración de OpenAI (si usas GPT)
# OPENAI_API_KEY=tu-openai-api-key
# OPENAI_MODEL=gpt-3.5-turbo

# Configuración de Vertex AI (si usas PaLM/Gemini)
# VERTEX_AI_MODEL=text-bison@001
# VERTEX_AI_LOCATION=us-central1

# Configuración de búsqueda
MAX_SEARCH_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# Configuración de cache (Redis si implementas)
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=3600

# Configuración de rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600  # 1 hora

# Para desarrollo local con credenciales de servicio
# GOOGLE_APPLICATION_CREDENTIALS=./rag-service-key.json