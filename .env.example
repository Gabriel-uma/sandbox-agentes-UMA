# Variables de entorno para el Frontend
# Copiar este archivo como .env y actualizar con las URLs reales después del despliegue

# URL del servicio Document Processor en Cloud Run
# Obtener con: cd infra && terraform output document_processor_url
VITE_DOCUMENT_PROCESSOR_URL=https://rag-document-processor-xxx-uc.a.run.app

# URL del servicio RAG Backend en Cloud Run
# Obtener con: cd infra && terraform output rag_backend_url
VITE_RAG_BACKEND_URL=https://rag-agent-backend-xxx-uc.a.run.app

# Project ID de GCP
VITE_PROJECT_ID=uma-tech-ai-lab

# Nombre del bucket de Cloud Storage
VITE_BUCKET_NAME=uma-tech-ai-lab-rag-documents

# URL del servicio SmartAudit Backend
# Obtener después del despliegue del backend de SmartAudit
VITE_SMARTAUDIT_API_URL=https://smartaudit-backend-xxx-uc.a.run.app
